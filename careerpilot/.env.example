# Optional. Adds more jobs from Adzuna. Without a key, the app still uses the companies in companies.json.
# 1. Copy this file and name the copy .env
# 2. Get your own app ID and key from https://developer.adzuna.com
# 3. Put them below. Never publish your .env file or share your key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# The country to search, as a two-letter code. "in" is India.
ADZUNA_COUNTRY=in
