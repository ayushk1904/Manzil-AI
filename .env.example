# Copy this file, name the copy .env, and fill in your own values. Never publish your .env file or share your keys.

# --- Resource Hub search: without the YouTube key the search says it isn't active yet ---
YOUTUBE_API_KEY=your-youtube-api-key
# Optional: live web results. Without a key, the Resources tab shows saved links. Get a key from https://app.tavily.com
TAVILY_API_KEY=

# --- Optional: more jobs from Adzuna. Without a key, the agent uses the companies in companies.json ---
# Get your own app ID and key from https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# The country to search, as a two-letter code. "in" is India.
ADZUNA_COUNTRY=in

# --- Optional: a public link that never changes, for start-fixed-link.bat. See the README ---
# Your free static domain from https://dashboard.ngrok.com/domains
NGROK_DOMAIN=

# --- Optional: where the app runs. It only accepts connections from this computer by default ---
# Only set the host when you deploy it. See the README first.
# CAREERPILOT_HOST=127.0.0.1
# CAREERPILOT_PORT=8000
